class StaticFileHandler:
    """
    Static file serving with memory-mapped files for zero-copy performance.

    Serves files from a directory with caching and optional SPA fallback.
    """

    directory: str
    prefix: str

    def __init__(
        self,
        directory: str,
        prefix: str = "/static",
        index: str = "index.html",
        spa: bool = False,
        cache_max_age: int | None = None,
    ) -> None: ...
    def serve_file(
        self,
        path: str,
        if_none_match: str | None = None,
    ) -> tuple[bytes, str, str, int]: ...
    def clear_cache_py(self) -> None: ...


