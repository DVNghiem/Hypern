    result: str | None
    error: str | None
    started_at: float | None
    completed_at: float | None

    def is_success(self) -> bool: ...
    def is_failed(self) -> bool: ...
    def is_pending(self) -> bool: ...


class TaskExecutor:
    """Background task executor with worker pool."""

    def __init__(
        self,
