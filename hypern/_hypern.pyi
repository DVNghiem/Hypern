from collections.abc import Callable
from dataclasses import dataclass
from enum import Enum
from typing import Any, Self

# ============================================================================
# HTTP Core
# ============================================================================

class Request:
    """Zero-copy HTTP request structure."""
    path: str
    method: str
    query_string: str
    path_params: dict[str, str]
    query_params: dict[str, str]
    headers: dict[str, str]
    ip: str | None
    ips: list[str]
    xhr: bool
    secure: bool
    hostname: str | None
    url: str
    original_url: str
    protocol: str

    def query(self, name: str) -> str | None: ...
    def param(self, name: str) -> str | None: ...
    def header(self, name: str) -> str | None: ...
    def accepts(self, types: list[str]) -> str | None: ...
    def accepts_json(self) -> bool: ...
    def accepts_html(self) -> bool: ...
    def subdomains(self) -> list[str]: ...
    def cookie(self, name: str) -> str | None: ...
    def cookies(self) -> dict[str, str]: ...
    def body_bytes(self) -> bytes: ...
    def json(self) -> Any: ...
    def content_type(self) -> str | None: ...
    def is_content_type(self, content_type: str) -> bool: ...
    def is_json(self) -> bool: ...
    def is_form(self) -> bool: ...
    def is_multipart(self) -> bool: ...
    def form(self) -> FormData: ...
    def file(self, name: str) -> UploadedFile | None: ...
    def files(self) -> list[UploadedFile]: ...
    def fresh(self, etag: str | None, last_modified: str | None) -> bool: ...
    def stale(self, etag: str | None, last_modified: str | None) -> bool: ...


class Response:
    """Express.js-compatible HTTP response writer."""
    status_code: int
    headers_sent: bool
    finished: bool

    def status(self, status: int) -> Response: ...
    def header(self, key: str, value: str) -> Response: ...
    def set(self, key: str, value: str) -> Response: ...
    def get(self, key: str) -> str | None: ...
    def remove_header(self, key: str) -> Response: ...
    def headers(self, headers: dict[str, str]) -> Response: ...
    def append(self, key: str, value: str) -> Response: ...
    def vary(self, field: str) -> Response: ...
    def links(self, links: dict[str, str]) -> Response: ...
    def location(self, url: str) -> Response: ...
    def etag(self, value: str) -> Response: ...
    def last_modified(self, date: str) -> Response: ...
    def expires(self, date: str) -> Response: ...
    def content_type(self, mime_type: str) -> Response: ...
    def type(self, mime_type: str) -> Response: ...
    def body(self, body: bytes) -> Response: ...
    def body_str(self, body: str) -> Response: ...
    def write(self, data: bytes) -> Response: ...
    def append_body(self, data: bytes) -> Response: ...
    def finish(self) -> None: ...
    def end(self, data: str | bytes | None = None) -> Response: ...
    def send_status(self, status: int) -> Response: ...
    # ExpressJS-like methods
    def send(self, data: str | bytes | None) -> Response: ...
    def json(self, data: Any) -> Response: ...
    def html(self, content: str) -> Response: ...
    def text(self, content: str) -> Response: ...
    def xml(self, content: str) -> Response: ...
    def redirect(self, url: str, status: int = 302) -> Response: ...
    def cookie(
        self,
        name: str,
        value: str,
        max_age: int | None = None,
        path: str | None = None,
        domain: str | None = None,
        secure: bool = False,
        http_only: bool = False,
        same_site: str | None = None,
    ) -> Response: ...
    def clear_cookie(
        self,
        name: str,
        path: str | None = None,
        domain: str | None = None,
    ) -> Response: ...
    def cache_control(
        self,
        max_age: int = 0,
        private: bool = False,
        no_cache: bool = False,
        no_store: bool = False,
    ) -> Response: ...
    def no_cache(self) -> Response: ...
    def cors(
        self,
        origin: str = "*",
        methods: list[str] | None = None,
        headers: list[str] | None = None,
        credentials: bool = False,
        max_age: int | None = None,
    ) -> Response: ...
    def attachment(self, filename: str | None = None) -> Response: ...
    def send_file(
        self,
        path: str,
        filename: str | None = None,
        content_type: str | None = None,
    ) -> Response: ...
    def download(self, path: str, filename: str | None = None) -> Response: ...
    # SSE/Streaming methods
    def sse(self, events: list[SSEEvent]) -> Response: ...
    def sse_collect(self, generator: Any) -> Response: ...
    def sse_stream(self, generator: Any) -> Response: ...
    def sse_event(
        self,
        data: str,
        event: str | None = None,
        id: str | None = None,
    ) -> Response: ...
    def sse_headers(self) -> Response: ...


class HeaderMap:
